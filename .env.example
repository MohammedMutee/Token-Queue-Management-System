# ── Database ──────────────────────────────────────────────────
# For local dev (PostgreSQL via Docker Compose on port 5433):
DATABASE_URL="postgresql://token:token@localhost:5433/tokendb"

# For the app running inside Docker Compose (uses service name "db"):
# DATABASE_URL="postgresql://token:token@db:5432/tokendb"

# ── Authentication (NextAuth v5) ──────────────────────────────
# Generate a real secret for production: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# The public URL where the app is accessible
NEXTAUTH_URL="http://localhost:3000"

# Trust the Host header (required behind reverse proxies / Docker)
AUTH_TRUST_HOST=true
